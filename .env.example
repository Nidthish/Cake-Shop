# Razorpay — get these from https://dashboard.razorpay.com/app/keys
# NEVER commit real values. NEXT_PUBLIC_ is NOT used for the secret on purpose.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Optional: for verifying Razorpay webhook calls (recommended for production)
RAZORPAY_WEBHOOK_SECRET=
