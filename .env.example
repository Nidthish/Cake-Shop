# Razorpay — get these from https://dashboard.razorpay.com/app/keys
# NEVER commit real values. NEXT_PUBLIC_ is NOT used for the secret on purpose.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Optional: for verifying Razorpay webhook calls (recommended for production)
RAZORPAY_WEBHOOK_SECRET=

# Free Email Notification Settings (Gmail SMTP / Nodemailer)
# Step 1: Enable 2-Step Verification in your Google Account
# Step 2: Go to https://myaccount.google.com/apppasswords and create an "App Password"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-email@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM="Lollipop Cake Shop" <your-email@gmail.com>
