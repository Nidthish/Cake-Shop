# Database Connection URL (Neon PostgreSQL Serverless)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Authentication & Security Keys
JWT_SECRET=your_jwt_secret_key_change_in_production
INITIAL_ADMIN_EMAIL=admin@lollipopcakeshop.com
INITIAL_ADMIN_PASSWORD=your_secure_admin_password_here

# Razorpay — get these from https://dashboard.razorpay.com/app/keys
# NEVER commit real values. NEXT_PUBLIC_ is NOT used for the secret on purpose.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Optional: for verifying Razorpay webhook calls (recommended for production)
RAZORPAY_WEBHOOK_SECRET=

# Free Email Notification Settings (Gmail SMTP / Nodemailer)
# Step 1: Enable 2-Step Verification in your Google Account
# Step 2: Go to https://myaccount.google.com/apppasswords and create an "App Password"
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=trichylollipop@gmail.com
SMTP_PASS=xxxx-xxxx-xxxx-xxxx
EMAIL_FROM="Lollipop Store" <your-email@gmail.com>
