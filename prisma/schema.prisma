generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 BigInt              @id @default(autoincrement())
  email              String              @unique @db.VarChar(150)
  passwordHash       String?             @map("password_hash") @db.VarChar(255)
  fullName           String              @map("full_name") @db.VarChar(120)
  phone              String?             @db.VarChar(20)
  role               Role                @default(CUSTOMER)
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")
  updatedAt          DateTime            @updatedAt @map("updated_at")
  auditLogs          AuditLog[]
  customCakeRequests CustomCakeRequest[]
  orders             Order[]

  @@map("users")
}

model Category {
  id          BigInt    @id @default(autoincrement())
  name        String    @unique @db.VarChar(100)
  slug        String    @unique @db.VarChar(120)
  description String?
  imageName   String?   @map("image_name") @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  products    Product[]

  @@index([name])
  @@map("categories")
}

model Product {
  id          BigInt           @id @default(autoincrement())
  categoryId  BigInt           @map("category_id")
  productCode String           @unique @map("product_code") @db.VarChar(100)
  name        String           @db.VarChar(255)
  slug        String           @unique @db.VarChar(255)
  description String?
  imageName   String?          @map("image_name") @db.VarChar(500)
  badge       String?          @db.VarChar(100)
  rating      Decimal          @default(5.00) @db.Decimal(3, 2)
  reviewCount Int              @default(0) @map("review_count")
  isActive    Boolean          @default(true) @map("is_active")
  productType ProductType      @map("product_type")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  orderItems  OrderItem[]
  offers      ProductOffer[]
  variants    ProductVariant[]
  category    Category         @relation(fields: [categoryId], references: [id])

  @@index([categoryId])
  @@index([productType])
  @@index([isActive])
  @@map("products")
}

model ProductVariant {
  id          BigInt         @id @default(autoincrement())
  productId   BigInt         @map("product_id")
  name        String         @db.VarChar(50)
  weightValue Decimal?       @map("weight_value") @db.Decimal(8, 3)
  weightUnit  String?        @map("weight_unit") @db.VarChar(10)
  price       Decimal        @db.Decimal(10, 2)
  isEggless   Boolean        @default(true) @map("is_eggless")
  serves      String?        @db.VarChar(50)
  isAvailable Boolean        @default(true) @map("is_available")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  orderItems  OrderItem[]
  buyOffers   ProductOffer[] @relation("BuyVariant")
  freeOffers  ProductOffer[] @relation("FreeVariant")
  product     Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, name, isEggless])
  @@index([productId])
  @@map("product_variants")
}

model ProductOffer {
  id            BigInt         @id @default(autoincrement())
  productId     BigInt         @map("product_id")
  buyVariantId  BigInt         @map("buy_variant_id")
  freeVariantId BigInt         @map("free_variant_id")
  buyQuantity   Int            @default(1) @map("buy_quantity")
  freeQuantity  Int            @default(1) @map("free_quantity")
  isActive      Boolean        @default(true) @map("is_active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  buyVariant    ProductVariant @relation("BuyVariant", fields: [buyVariantId], references: [id])
  freeVariant   ProductVariant @relation("FreeVariant", fields: [freeVariantId], references: [id])
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([buyVariantId])
  @@index([freeVariantId])
  @@map("product_offers")
}

model CustomCakeRequest {
  id                BigInt         @id @default(autoincrement())
  userId            BigInt?        @map("user_id")
  customerName      String         @map("customer_name") @db.VarChar(120)
  customerPhone     String         @map("customer_phone") @db.VarChar(20)
  customerEmail     String         @map("customer_email") @db.VarChar(150)
  customType        CustomCakeType @default(CUSTOMIZED) @map("custom_type")
  flavorPreference  String         @map("flavor_preference") @db.VarChar(100)
  isEggless         Boolean        @default(false) @map("is_eggless")
  tierOrWeight      String         @map("tier_or_weight") @db.VarChar(50)
  description       String?
  referenceImageUrl String?        @map("reference_image_url") @db.VarChar(500)
  referenceVideoUrl String?        @map("reference_video_url") @db.VarChar(500)
  cakeMessage       String?        @map("cake_message") @db.VarChar(150)
  requestedDate     DateTime       @map("requested_date")
  requestedTimeSlot String         @map("requested_time_slot") @db.VarChar(50)
  status            String         @default("PENDING_QUOTE") @db.VarChar(30)
  quotedPrice       Decimal?       @map("quoted_price") @db.Decimal(10, 2)
  adminNotes        String?        @map("admin_notes")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")
  user              User?          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("custom_cake_requests")
}

model Order {
  id               BigInt      @id @default(autoincrement())
  orderNumber      String      @unique @map("order_number") @db.VarChar(50)
  userId           BigInt?     @map("user_id")
  customerName     String      @map("customer_name") @db.VarChar(120)
  customerEmail    String      @map("customer_email") @db.VarChar(150)
  customerPhone    String      @map("customer_phone") @db.VarChar(20)
  streetAddress    String      @map("street_address")
  city             String      @db.VarChar(80)
  pincode          String      @db.VarChar(10)
  state            String      @default("Tamil Nadu") @db.VarChar(80)
  landmark         String?     @db.VarChar(150)
  deliveryDate     DateTime    @map("delivery_date")
  deliveryTimeSlot String      @map("delivery_time_slot") @db.VarChar(50)
  deliveryNotes    String?     @map("delivery_notes")
  hasEgglessItems  Boolean     @default(false) @map("has_eggless_items")
  subtotal         Decimal     @db.Decimal(10, 2)
  sgst             Decimal     @db.Decimal(10, 2)
  cgst             Decimal     @db.Decimal(10, 2)
  taxAmount        Decimal     @map("tax_amount") @db.Decimal(10, 2)
  deliveryFee      Decimal     @default(0.00) @map("delivery_fee") @db.Decimal(10, 2)
  discountAmount   Decimal     @default(0.00) @map("discount_amount") @db.Decimal(10, 2)
  totalAmount      Decimal     @map("total_amount") @db.Decimal(10, 2)
  status           OrderStatus @default(PENDING)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")
  items            OrderItem[]
  user             User?       @relation(fields: [userId], references: [id])
  payment          Payment?

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id          BigInt          @id @default(autoincrement())
  orderId     BigInt          @map("order_id")
  productId   BigInt          @map("product_id")
  variantId   BigInt?         @map("variant_id")
  productCode String          @map("product_code") @db.VarChar(100)
  productName String          @map("product_name") @db.VarChar(255)
  variantName String          @map("variant_name") @db.VarChar(100)
  isEggless   Boolean         @default(false) @map("is_eggless")
  quantity    Int             @default(1)
  unitPrice   Decimal         @map("unit_price") @db.Decimal(10, 2)
  lineTotal   Decimal         @map("line_total") @db.Decimal(10, 2)
  cakeMessage String?         @map("cake_message") @db.VarChar(150)
  createdAt   DateTime        @default(now()) @map("created_at")
  order       Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id                BigInt        @id @default(autoincrement())
  orderId           BigInt        @unique @map("order_id")
  paymentMethod     PaymentMethod @default(RAZORPAY) @map("payment_method")
  paymentStatus     PaymentStatus @default(PENDING) @map("payment_status")
  currency          String        @default("INR") @db.VarChar(10)
  amount            Decimal       @db.Decimal(10, 2)
  razorpayOrderId   String?       @unique @map("razorpay_order_id") @db.VarChar(100)
  razorpayPaymentId String?       @unique @map("razorpay_payment_id") @db.VarChar(100)
  razorpaySignature String?       @map("razorpay_signature")
  refundId          String?       @map("refund_id") @db.VarChar(100)
  refundAmount      Decimal?      @map("refund_amount") @db.Decimal(10, 2)
  failureReason     String?       @map("failure_reason")
  paidAt            DateTime?     @map("paid_at")
  refundedAt        DateTime?     @map("refunded_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    BigInt?  @map("user_id")
  action    String   @db.VarChar(100)
  details   String?
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  createdAt DateTime @default(now()) @map("created_at")
  user      User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

enum ProductType {
  CAKE
  SNACK
}

enum Role {
  SUPERADMIN
  ADMIN
  STAFF
  CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  INITIATED
  PAID
  PAYMENT_FAILED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  COD
  UPI
  CARD
  NET_BANKING
}

enum CustomCakeType {
  CUSTOMIZED
  WEDDING
  BENTO
  FIRST_BIRTHDAY
  DREAM_CAKE
}
