// ─────────────────────────────────────────────────────────────────────────
// Lollipop Cake Shop — Production-Ready Database Schema for MySQL 8.0 & Neon PostgreSQL
// ─────────────────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── ENUMS ────────────────────────────────────────────────────────────────

enum ProductType {
  CAKE
  SNACK
}

enum Role {
  SUPERADMIN
  ADMIN
  STAFF
  CUSTOMER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  INITIATED
  PAID
  PAYMENT_FAILED
  REFUNDED
}

enum PaymentMethod {
  RAZORPAY
  COD
  UPI
  CARD
  NET_BANKING
}

enum CustomCakeType {
  CUSTOMIZED
  WEDDING
  BENTO
  FIRST_BIRTHDAY
  DREAM_CAKE
}

// ── 1. USERS & ADMIN AUTHENTICATION ──────────────────────────────────────

model User {
  id           BigInt   @id @default(autoincrement())
  email        String   @unique @db.VarChar(150)
  passwordHash String?  @map("password_hash") @db.VarChar(255)
  fullName     String   @map("full_name") @db.VarChar(120)
  phone        String?  @db.VarChar(20)
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @map("is_active") @default(true)
  createdAt    DateTime @map("created_at") @default(now())
  updatedAt    DateTime @map("updated_at") @updatedAt

  orders             Order[]
  customCakeRequests CustomCakeRequest[]
  auditLogs          AuditLog[]

  @@map("users")
}

// ── 2. CATEGORIES ─────────────────────────────────────────────────────────

model Category {
  id          BigInt   @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  slug        String   @unique @db.VarChar(120)
  description String?  @db.Text
  imageName   String?  @map("image_name") @db.VarChar(255)

  products    Product[]

  createdAt   DateTime @map("created_at") @default(now())
  updatedAt   DateTime @map("updated_at") @updatedAt

  @@index([name])
  @@map("categories")
}

// ── 3. PRODUCTS ───────────────────────────────────────────────────────────

model Product {
  id           BigInt      @id @default(autoincrement())
  categoryId   BigInt      @map("category_id")

  productCode  String      @unique @map("product_code") @db.VarChar(30)
  name         String      @db.VarChar(200)
  slug         String      @unique @db.VarChar(220)
  description  String?     @db.Text
  imageName    String?     @map("image_name") @db.VarChar(255)
  badge        String?     @db.VarChar(50)  // "Bestseller", "New", "1kg Free Offer"
  rating       Decimal     @default(5.00) @db.Decimal(3, 2)
  reviewCount  Int         @map("review_count") @default(0)
  isActive     Boolean     @map("is_active") @default(true)   // Admin switch to enable/disable product

  productType  ProductType @map("product_type")

  category     Category    @relation(fields: [categoryId], references: [id])

  variants     ProductVariant[]
  offers       ProductOffer[]
  orderItems   OrderItem[]

  createdAt    DateTime    @map("created_at") @default(now())
  updatedAt    DateTime    @map("updated_at") @updatedAt

  @@index([categoryId])
  @@index([productType])
  @@index([isActive])
  @@map("products")
}

// ── 4. PRODUCT VARIANTS (Size, Price, Egg/Eggless, Servings) ─────────────

model ProductVariant {
  id           BigInt    @id @default(autoincrement())
  productId    BigInt    @map("product_id")

  name         String    @db.VarChar(50)   // "0.5kg", "1kg", "Step 2", etc.
  weightValue  Decimal?  @map("weight_value") @db.Decimal(8, 3)
  weightUnit   String?   @map("weight_unit") @db.VarChar(10)   // "kg", "g"

  price        Decimal   @db.Decimal(10, 2)
  isEggless    Boolean   @map("is_eggless") @default(true)
  serves       String?   @db.VarChar(50)   // "4-6", "8-10"
  isAvailable  Boolean   @map("is_available") @default(true)   // Admin variant toggle

  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  buyOffers    ProductOffer[] @relation("BuyVariant")
  freeOffers   ProductOffer[] @relation("FreeVariant")
  orderItems   OrderItem[]

  createdAt    DateTime  @map("created_at") @default(now())
  updatedAt    DateTime  @map("updated_at") @updatedAt

  @@unique([productId, name, isEggless])
  @@index([productId])
  @@map("product_variants")
}

// ── 5. PRODUCT OFFERS (Buy-X-Get-Y Buy 1kg Get 0.5kg Free) ───────────────

model ProductOffer {
  id             BigInt    @id @default(autoincrement())
  productId      BigInt    @map("product_id")

  buyVariantId   BigInt    @map("buy_variant_id")
  freeVariantId  BigInt    @map("free_variant_id")

  buyQuantity    Int       @map("buy_quantity") @default(1)
  freeQuantity   Int       @map("free_quantity") @default(1)
  isActive       Boolean   @map("is_active") @default(true)

  product        Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  buyVariant     ProductVariant @relation("BuyVariant", fields: [buyVariantId], references: [id])
  freeVariant    ProductVariant @relation("FreeVariant", fields: [freeVariantId], references: [id])

  createdAt      DateTime  @map("created_at") @default(now())
  updatedAt      DateTime  @map("updated_at") @updatedAt

  @@index([productId])
  @@index([buyVariantId])
  @@index([freeVariantId])
  @@map("product_offers")
}

// ── 6. CUSTOM, BENTO, WEDDING & 1st BIRTHDAY CAKE REQUESTS ──────────────

model CustomCakeRequest {
  id                BigInt         @id @default(autoincrement())
  userId            BigInt?        @map("user_id")
  customerName      String         @map("customer_name") @db.VarChar(120)
  customerPhone     String         @map("customer_phone") @db.VarChar(20)
  customerEmail     String         @map("customer_email") @db.VarChar(150)

  customType        CustomCakeType @map("custom_type") @default(CUSTOMIZED)
  flavorPreference  String         @map("flavor_preference") @db.VarChar(100)
  isEggless         Boolean        @map("is_eggless") @default(false)
  tierOrWeight      String         @map("tier_or_weight") @db.VarChar(50)     // "3 Tiers", "5kg", "Bento Mini"
  description       String?        @db.Text
  referenceImageUrl String?        @map("reference_image_url") @db.VarChar(500)
  referenceVideoUrl String?        @map("reference_video_url") @db.VarChar(500)
  cakeMessage       String?        @map("cake_message") @db.VarChar(150)

  requestedDate     DateTime       @map("requested_date")
  requestedTimeSlot String         @map("requested_time_slot") @db.VarChar(50)
  status            String         @default("PENDING_QUOTE") @db.VarChar(30)
  quotedPrice       Decimal?       @map("quoted_price") @db.Decimal(10, 2)
  adminNotes        String?        @map("admin_notes") @db.Text

  user              User?          @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt         DateTime       @map("created_at") @default(now())
  updatedAt         DateTime       @map("updated_at") @updatedAt

  @@index([userId])
  @@index([status])
  @@map("custom_cake_requests")
}

// ── 7. ORDERS ────────────────────────────────────────────────────────────

model Order {
  id               BigInt      @id @default(autoincrement())
  orderNumber      String      @unique @map("order_number") @db.VarChar(50) // e.g. "LOL-20260919-9812"
  userId           BigInt?     @map("user_id")

  // Customer Contact Info
  customerName     String      @map("customer_name") @db.VarChar(120)
  customerEmail    String      @map("customer_email") @db.VarChar(150)
  customerPhone    String      @map("customer_phone") @db.VarChar(20)

  // Delivery Address Details
  streetAddress    String      @map("street_address") @db.Text
  city             String      @db.VarChar(80)
  pincode          String      @db.VarChar(10)
  state            String      @default("Tamil Nadu") @db.VarChar(80)
  landmark         String?     @db.VarChar(150)

  // Delivery Schedule & Eggless Lead Time Constraints
  deliveryDate     DateTime    @map("delivery_date")
  deliveryTimeSlot String      @map("delivery_time_slot") @db.VarChar(50)
  deliveryNotes    String?     @map("delivery_notes") @db.Text
  hasEgglessItems  Boolean     @map("has_eggless_items") @default(false)

  // Order Financial Breakdown
  subtotal         Decimal     @db.Decimal(10, 2)
  sgst             Decimal     @db.Decimal(10, 2)
  cgst             Decimal     @db.Decimal(10, 2)
  taxAmount        Decimal     @map("tax_amount") @db.Decimal(10, 2)
  deliveryFee      Decimal     @map("delivery_fee") @default(0.00) @db.Decimal(10, 2)
  discountAmount   Decimal     @map("discount_amount") @default(0.00) @db.Decimal(10, 2)
  totalAmount      Decimal     @map("total_amount") @db.Decimal(10, 2)

  status           OrderStatus @default(PENDING)

  user             User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items            OrderItem[]
  payment          Payment?

  createdAt        DateTime    @map("created_at") @default(now())
  updatedAt        DateTime    @map("updated_at") @updatedAt

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@map("orders")
}

// ── 8. ORDER ITEMS ───────────────────────────────────────────────────────

model OrderItem {
  id            BigInt         @id @default(autoincrement())
  orderId       BigInt         @map("order_id")
  productId     BigInt         @map("product_id")
  variantId     BigInt?        @map("variant_id")

  productCode   String         @map("product_code") @db.VarChar(30)
  productName   String         @map("product_name") @db.VarChar(200)
  variantName   String         @map("variant_name") @db.VarChar(50)
  isEggless     Boolean        @map("is_eggless") @default(false)

  quantity      Int            @default(1)
  unitPrice     Decimal        @map("unit_price") @db.Decimal(10, 2)
  lineTotal     Decimal        @map("line_total") @db.Decimal(10, 2)
  cakeMessage   String?        @map("cake_message") @db.VarChar(150) // Text to write on the cake

  order         Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id])
  variant       ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  createdAt     DateTime       @map("created_at") @default(now())

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

// ── 9. PAYMENTS (Secured Gateway Credentials & Refund Audits) ────────────

model Payment {
  id                BigInt        @id @default(autoincrement())
  orderId           BigInt        @unique @map("order_id")
  paymentMethod     PaymentMethod @map("payment_method") @default(RAZORPAY)
  paymentStatus     PaymentStatus @map("payment_status") @default(PENDING)
  currency          String        @default("INR") @db.VarChar(10)
  amount            Decimal       @db.Decimal(10, 2)

  // Razorpay Confidential References
  razorpayOrderId   String?       @unique @map("razorpay_order_id") @db.VarChar(100)
  razorpayPaymentId String?       @unique @map("razorpay_payment_id") @db.VarChar(100)
  razorpaySignature String?       @map("razorpay_signature") @db.Text
  refundId          String?       @map("refund_id") @db.VarChar(100)
  refundAmount      Decimal?      @map("refund_amount") @db.Decimal(10, 2)
  failureReason     String?       @map("failure_reason") @db.Text

  paidAt            DateTime?     @map("paid_at")
  refundedAt        DateTime?     @map("refunded_at")

  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt         DateTime      @map("created_at") @default(now())
  updatedAt         DateTime      @map("updated_at") @updatedAt

  @@map("payments")
}

// ── 10. AUDIT & LOGGING ──────────────────────────────────────────────────

model AuditLog {
  id          BigInt   @id @default(autoincrement())
  userId      BigInt?  @map("user_id")
  action      String   @db.VarChar(100) // e.g. "PRICING_UPDATE", "CANCEL_ORDER_REFUND"
  details     String?  @db.Text
  ipAddress   String?  @map("ip_address") @db.VarChar(45)

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt   DateTime @map("created_at") @default(now())

  @@map("audit_logs")
}
